# =========================================================
# SERVER ENVIRONMENT CONFIGURATION (.env.example)
# Sao chép file này thành .env trước khi chạy: 
# Windows: copy .env.example .env | Mac/Linux: cp .env.example .env
# =========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# Chạy local MongoDB: mongodb://localhost:27017/hust_food
# Hoặc MongoDB Atlas cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/hust_food
DATABASE_URL=mongodb://localhost:27017/hust_food

# JWT Secrets (Dùng để xác thực đăng nhập sinh viên / admin)
JWT_SECRET=hust_food_super_secret_jwt_key_2026_bach_khoa
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=hust_food_refresh_token_secret_key_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# Cloudinary (Lưu trữ ảnh review, avatar sinh viên, bài viết)
CLOUDINARY_CLOUD_NAME=hust-food-demo
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

