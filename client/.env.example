# =========================================================
# CLIENT ENVIRONMENT CONFIGURATION (.env.example)
# Sao chép file này thành .env trước khi chạy: 
# Windows: copy .env.example .env | Mac/Linux: cp .env.example .env
# =========================================================

# API & WebSocket Backend Server
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Map Default Coordinates (Tâm Đại học Bách Khoa Hà Nội - Cổng Parabol)
VITE_DEFAULT_LAT=21.0055
VITE_DEFAULT_LNG=105.8431
VITE_DEFAULT_ZOOM=16

# Mapbox API Public Token (Lấy miễn phí tại: https://account.mapbox.com/)
# Mặc định nếu để trống, hệ thống sẽ tự động dùng OpenStreetMap / CartoDB miễn phí 100%
VITE_MAPBOX_API_KEY=your_mapbox_public_token_here
