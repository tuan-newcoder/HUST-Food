{
  "info": {
    "_postman_id": "hust-food-be1-collection",
    "name": "HUST Food - BE1 API Collection (F01 - F10)",
    "description": "Bộ API hoàn chỉnh cho Phân hệ 1 & 2 (F01 đến F10) do BE 1 bàn giao cho FE 1 và Team",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (F01)",
      "item": [
        {
          "name": "Đăng ký tài khoản (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"foodie_hust\",\n  \"email\": \"foodie@hust.edu.vn\",\n  \"password\": \"123456\",\n  \"fullName\": \"HUST Food Reviewer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Đăng nhập (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrUsername\": \"foodie_hust\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Làm mới Token (Refresh Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Đăng xuất (Logout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users & Profile (F02 - F04)",
      "item": [
        {
          "name": "Xem Profile cá nhân (Get My Profile)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Cập nhật Profile cá nhân (Update Profile)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"HUST Food Reviewer Pro\",\n  \"bio\": \"Khám phá tất cả các quán ăn ngon quanh Bách Khoa\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Xem trang cá nhân người khác (Public Profile)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/foodie_hust",
              "host": ["{{baseUrl}}"],
              "path": ["users", "foodie_hust"]
            }
          }
        },
        {
          "name": "Lấy bài viết theo username",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/foodie_hust/posts?postType=ALL&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["users", "foodie_hust", "posts"],
              "query": [
                { "key": "postType", "value": "ALL" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Toggle Theo dõi / Bỏ theo dõi (Follow / Unfollow)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/:targetUserId/follow",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":targetUserId", "follow"],
              "variable": [
                { "key": "targetUserId", "value": "USER_ID_CAN_FOLLOW" }
              ]
            }
          }
        },
        {
          "name": "Lấy danh sách Followers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/:targetUserId/followers?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":targetUserId", "followers"],
              "query": [{ "key": "limit", "value": "20" }],
              "variable": [{ "key": "targetUserId", "value": "USER_ID" }]
            }
          }
        },
        {
          "name": "Lấy danh sách Following",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/:targetUserId/following?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":targetUserId", "following"],
              "query": [{ "key": "limit", "value": "20" }],
              "variable": [{ "key": "targetUserId", "value": "USER_ID" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Upload Media",
      "item": [
        {
          "name": "Tải lên ảnh (Upload Images)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload/images",
              "host": ["{{baseUrl}}"],
              "path": ["upload", "images"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Posts & Newsfeed (F05 - F10)",
      "item": [
        {
          "name": "Bảng tin Newsfeed (Infinite Scroll Feed)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/feed?postType=ALL&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "feed"],
              "query": [
                { "key": "postType", "value": "ALL" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Top Tags thịnh hành (Trending Tags)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts/tags/trending?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "tags", "trending"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "Đăng bài Review Quán ăn (Create Review Post)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postType\": \"REVIEW\",\n  \"title\": \"Bún cá cay Hải Phòng chuẩn vị, nước dùng đậm đà!\",\n  \"content\": \"Nước dùng ngọt thanh, cá rán giòn rụm bên ngoài mềm bên trong. Không gian quán rộng rãi.\",\n  \"images\": [\"https://res.cloudinary.com/hustfood/image/upload/v1/bunca1.jpg\"],\n  \"tags\": [\"bun-ca\", \"hai-phong\", \"an-trua\"],\n  \"restaurantInfo\": {\n    \"name\": \"Bún Cá Cay Gia Truyền\",\n    \"address\": \"Số 15 Phố Huế, Hai Bà Trưng, Hà Nội\",\n    \"priceRange\": { \"min\": 35000, \"max\": 55000 },\n    \"ratings\": {\n      \"taste\": 5,\n      \"price\": 5,\n      \"hygiene\": 4,\n      \"service\": 5\n    },\n    \"location\": {\n      \"type\": \"Point\",\n      \"coordinates\": [105.8515, 21.0182]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          }
        },
        {
          "name": "Đăng bài Công thức nấu ăn (Create Recipe Post)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postType\": \"RECIPE\",\n  \"title\": \"Cách làm Phở Gà Trộn tại nhà cực ngon\",\n  \"content\": \"Công thức chuẩn vị Hà Nội cho bữa sáng cuối tuần nhanh gọn.\",\n  \"images\": [\"https://res.cloudinary.com/hustfood/image/upload/v1/phoga.jpg\"],\n  \"tags\": [\"pho-ga\", \"an-sang\", \"healthy\"],\n  \"recipeInfo\": {\n    \"cookingTimeMinutes\": 30,\n    \"estimatedCost\": 70000,\n    \"servings\": 2,\n    \"difficulty\": \"EASY\",\n    \"ingredients\": [\n      { \"name\": \"Thịt ức gà\", \"amount\": \"300g\" },\n      { \"name\": \"Bánh phở tươi\", \"amount\": \"500g\" },\n      { \"name\": \"Lạc rang & rau thơm\", \"amount\": \"50g\" }\n    ],\n    \"steps\": [\n      { \"stepNumber\": 1, \"instruction\": \"Luộc chín gà và xé sợi vừa ăn\", \"imageUrl\": \"\" },\n      { \"stepNumber\": 2, \"instruction\": \"Pha nước sốt chua ngọt và trộn đều các nguyên liệu\", \"imageUrl\": \"\" }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          }
        },
        {
          "name": "Xem chi tiết bài viết (Get Post Detail)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/:postId",
              "host": ["{{baseUrl}}"],
              "path": ["posts", ":postId"],
              "variable": [{ "key": "postId", "value": "POST_ID" }]
            }
          }
        },
        {
          "name": "Chỉnh sửa bài viết (Update Post)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bún cá cay Hải Phòng chuẩn vị (Đã cập nhật tiêu đề)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts/:postId",
              "host": ["{{baseUrl}}"],
              "path": ["posts", ":postId"],
              "variable": [{ "key": "postId", "value": "POST_ID" }]
            }
          }
        },
        {
          "name": "Xóa bài viết (Delete Post)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/:postId",
              "host": ["{{baseUrl}}"],
              "path": ["posts", ":postId"],
              "variable": [{ "key": "postId", "value": "POST_ID" }]
            }
          }
        }
      ]
    }
  ]
}
